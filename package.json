{
  "name": "dsh-console-sentinel",
  "version": "1.3.2",
  "description": "DSH console sentinel for Windows — one-click cleanup of taskbar windows and empty console shells, plus per-window provenance (parent chain / full command line / script path / start time) so you can see what spawned each console and decide whether to block it. Each row also carries a red parent chip (父：name(pid), or 父：已退出 for orphans whose parent already exited), and a one-click orphan cleanup closes console windows whose parent has exited but which kept running — safe mode never touches mpiexec/fluent/ansys/node compute processes. Graceful WM_CLOSE (= Alt+F4) per window or whole app, UAC-elevated close for admin apps, icon-grid and detail views, preview-before-execute, persistent whitelist, and hard protection for the DSH host and Fluent/MPI solvers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-console-sentinel.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-console-sentinel#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-console-sentinel/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "lib/**/*.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "CHANGELOG.md",
    "icon.svg",
    "docs/screenshots/*.png",
    "locale/*.json",
    "screenshots.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "console",
    "window",
    "taskbar",
    "close-window",
    "alt-f4",
    "wm-close",
    "uac",
    "elevated",
    "powershell",
    "process-manager",
    "windows"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "dsh": {
    "labels": [],
    "capabilities": ["network:egress", "tools:register"],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "packageManager": "pnpm@11.7.0"
}